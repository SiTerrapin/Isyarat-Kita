# Konfigurasi PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=isyarat_kita
DB_PORT=15432

# Koneksi SQLAlchemy & Script Migrasi/Seeder
DATABASE_URL=postgresql://postgres:password123@localhost:15432/isyarat_kita

# Keamanan JWT Authentication (WAJIB diganti saat production)
SECRET_KEY=isyarat-kita-ganti-dengan-secret-key-acak-yang-panjang
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Konfigurasi AI BISINDO (Set AI_MOCK_MODE=false setelah menaruh file .pth)
AI_MOCK_MODE=true
AI_MODEL_PATH=models/bisindo_convnext_tiny_gated_FINAL.pth
HAND_LANDMARKER_PATH=models/hand_landmarker.task
GLOSS_DATASET_PATH=models/bisindo_gloss_conversation_dataset.jsonl

# Konfigurasi Speech-to-Text (tiny / base)
STT_MODEL_SIZE=tiny

# Opsional: Hook LLM untuk /api/refine-text
# LLM_API_URL=
# LLM_API_KEY=
# GEMINI_API_KEY=
