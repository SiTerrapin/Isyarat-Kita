{
  "expo": {
    "name": "Isyarat Kita",
    "slug": "isyarat-kita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "isyaratkita",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Isyarat Kita membutuhkan akses kamera untuk menerjemahkan bahasa isyarat BISINDO secara real-time.",
        "NSMicrophoneUsageDescription": "Isyarat Kita membutuhkan akses mikrofon untuk mendeteksi suara darurat di sekitar Anda."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D9488",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.isyaratkita"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D9488",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Isyarat Kita membutuhkan akses kamera untuk menerjemahkan bahasa isyarat BISINDO secara real-time.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Izinkan Isyarat Kita mengakses mikrofon untuk mendeteksi peringatan suara darurat."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d309382d-f657-4c3a-baca-1e5707dc2275"
      }
    }
  }
}
